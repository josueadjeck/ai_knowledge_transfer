    private static string ExtractionStatusDetail(ExtractKnowledgeResponse? extraction)
    {
        if (extraction is null)
        {
            return "Keine Extraktion erzeugt.";
        }

        var fallback = extraction.UsedFallback ? ", Fallback aktiv" : string.Empty;
        return $"{extraction.CreatedItemCount} Elemente via {extraction.ProviderName}{fallback}";
    }

    private static string ExtractionDetail(ExtractKnowledgeResponse extraction)
    {
        return string.IsNullOrWhiteSpace(extraction.Detail)
            ? "Keine weiteren Provider-Details."
            : extraction.Detail;
    }

    private static int MarkdownLineCount(string markdown)
    {
        return markdown.Split('\n').Length;
    }

    private static IEnumerable<ExportPreviewSection> ExportSections(string markdown)
    {
        var sections = new List<ExportPreviewSection>();
        var title = "Kopfbereich";
        var lines = new List<string>();

        foreach (var line in markdown.Replace("\r\n", "\n", StringComparison.Ordinal).Split('\n'))
        {
            if (line.StartsWith("## ", StringComparison.Ordinal))
            {
                AddExportSection(sections, title, lines);
                title = line[3..].Trim();
                lines = [];
                continue;
            }

            lines.Add(line);
        }

        AddExportSection(sections, title, lines);
        return sections;
    }

    private static void AddExportSection(List<ExportPreviewSection> sections, string title, List<string> lines)
    {
        var preview = string.Join(Environment.NewLine, lines)
            .Trim();

        if (string.IsNullOrWhiteSpace(preview))
        {
            preview = "Keine Inhalte.";
        }

        const int maxPreviewLength = 1200;
        if (preview.Length > maxPreviewLength)
        {
            preview = $"{preview[..maxPreviewLength]}...";
        }

        sections.Add(new ExportPreviewSection(title, preview));
    }

    private static RenderFragment RenderRoadmapItems(IReadOnlyCollection<string> items) => builder =>
    {
        if (items.Count == 0)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "muted");
            builder.AddContent(2, "Keine Eintraege.");
            builder.CloseElement();
            return;
        }

        builder.OpenElement(3, "ul");
        var sequence = 4;
        foreach (var item in items)
        {
            builder.OpenElement(sequence++, "li");
            builder.AddContent(sequence++, item);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

