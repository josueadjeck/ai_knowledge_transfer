@page "/"
@rendermode InteractiveServer

@using AiKnowledgeTransfer.Application.Documents
@using AiKnowledgeTransfer.Application.Audit
@using AiKnowledgeTransfer.Application.Diagnostics
@using AiKnowledgeTransfer.Application.Exports
@using AiKnowledgeTransfer.Application.Knowledge
@using AiKnowledgeTransfer.Application.Operations
@using AiKnowledgeTransfer.Application.Projects
@using AiKnowledgeTransfer.Application.Roadmaps
@using AiKnowledgeTransfer.Application.Security
@using AiKnowledgeTransfer.Application.Traceability
@using AiKnowledgeTransfer.Contracts.Exports
@using AiKnowledgeTransfer.Contracts.Audit
@using AiKnowledgeTransfer.Contracts.Diagnostics
@using AiKnowledgeTransfer.Contracts.Operations
@using AiKnowledgeTransfer.Contracts.Projects
@using AiKnowledgeTransfer.Contracts.Roadmaps
@using AiKnowledgeTransfer.Contracts.Security
@using AiKnowledgeTransfer.Contracts.Traceability
@using AiKnowledgeTransfer.Contracts.Validation
@using Microsoft.AspNetCore.Components.Forms

@inject ProjectService Projects
@inject DocumentAnalysisService Analysis
@inject KnowledgeExtractionService Extraction
@inject KnowledgeReviewService Review
@inject RoadmapService Roadmaps
@inject MarkdownExportService MarkdownExports
@inject TraceabilityService Traceability
@inject RolePermissionService Permissions
@inject AuditLogService Audit
@inject PersistenceBackupService Backups
@inject OperationalHealthService Health

<PageTitle>AI Knowledge Transfer</PageTitle>

<section class="workspace-header">
    <div>
        <p class="eyebrow">MVP Workflow</p>
        <h1>Projektwissen aufnehmen, pruefen und in Einarbeitung verwandeln.</h1>
        <p class="header-copy">
            Ein durchgaengiger Arbeitsfluss fuer Upload, Analyse, Knowledge Extraction, Review, Roadmap, Traceability und Markdown Export.
        </p>
    </div>
    <div class="status-panel">
        <span class="status-label">Status</span>
        <strong>@StatusText</strong>
        <span class="@StatusCssClass">@StatusDetail</span>
        <label class="role-select">
            Rolle
            <select @bind="_currentRole">
                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <option value="@role">@role</option>
                }
            </select>
        </label>
    </div>
</section>

<section class="metric-grid" aria-label="MVP Status">
    <div class="metric-card">
        <span>Projekte</span>
        <strong>@_projects.Count</strong>
        <p>Im lokalen JSON-persistierten Workspace.</p>
    </div>
    <div class="metric-card">
        <span>Dokumente</span>
        <strong>@(_selectedProject?.Documents.Count ?? 0)</strong>
        <p>Hochgeladen oder registriert.</p>
    </div>
    <div class="metric-card">
        <span>Wissen</span>
        <strong>@(_selectedProject?.KnowledgeItems.Count ?? 0)</strong>
        <p>Extrahierte und reviewbare Elemente.</p>
    </div>
</section>

<section class="workflow-grid">
    <div class="workflow-panel">
        <h2>Projekt</h2>
        <div class="form-grid">
            <label>
                Name
                <input @bind="_newProject.Name" />
            </label>
            <label>
                Owner
                <input @bind="_newProject.Owner" />
            </label>
            <label class="span-2">
                Beschreibung
                <textarea @bind="_newProject.Description"></textarea>
            </label>
        </div>
        <button class="primary-action" @onclick="CreateProjectAsync" disabled="@(!Can(Permission.CreateProject))">Projekt anlegen</button>

        @if (_projects.Count > 0)
        {
            <label class="select-label">
                Aktives Projekt
                <select value="@_selectedProjectId" @onchange="SelectProjectAsync">
                    @foreach (var project in _projects)
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                </select>
            </label>
        }
    </div>

    <div class="workflow-panel">
        <h2>Dokument</h2>
        <label>
            Quelle
            <input @bind="_uploadSource" />
        </label>
        <InputFile OnChange="UploadDocumentAsync" disabled="@(_selectedProject is null || !Can(Permission.UploadDocument))" />
        <div class="button-row">
            <button @onclick="AnalyzeLatestDocumentAsync" disabled="@(!CanAnalyze)">Analysieren</button>
            <button @onclick="ExtractKnowledgeAsync" disabled="@(!CanExtract)">Wissen extrahieren</button>
        </div>
        @if (_lastExtraction is not null)
        {
            <div class="extraction-summary">
                <div>
                    <span>Provider</span>
                    <strong>@_lastExtraction.ProviderName</strong>
                </div>
                <div>
                    <span>Fallback</span>
                    <strong>@(_lastExtraction.UsedFallback ? "Ja" : "Nein")</strong>
                </div>
                <div>
                    <span>Ergebnis</span>
                    <strong>@_lastExtraction.CreatedItemCount Wissenselemente</strong>
                </div>
                <div class="span-2">
                    <span>Hinweis</span>
                    <strong>@ExtractionDetail(_lastExtraction)</strong>
                </div>
            </div>
        }

        @if (_selectedProject?.Documents.Count > 0)
        {
            <div class="compact-list">
                @foreach (var document in _selectedProject.Documents)
                {
                    <div class="document-card">
                        <div class="document-card-header">
                            <div>
                                <strong>@document.FileName</strong>
                                <span>@document.Status, @document.ChunkCount Chunks</span>
                            </div>
                            <span class="document-version">v@document.VersionNumber</span>
                        </div>
                        <dl class="document-meta">
                            <div>
                                <dt>Quelle</dt>
                                <dd>@document.Source</dd>
                            </div>
                            <div>
                                <dt>Typ</dt>
                                <dd>@document.ContentType</dd>
                            </div>
                            <div>
                                <dt>Groesse</dt>
                                <dd>@FormatFileSize(document.SizeInBytes)</dd>
                            </div>
                            <div>
                                <dt>Upload</dt>
                                <dd>@document.UploadedAt.LocalDateTime.ToString("g")</dd>
                            </div>
                            <div class="span-2">
                                <dt>Storage</dt>
                                <dd>@DocumentStorageLabel(document)</dd>
                            </div>
                        </dl>
                        @if (document.ChunkCount > 0)
                        {
                            <details class="chunk-preview">
                                <summary>Analyse-Auszug anzeigen</summary>
                                @foreach (var chunk in DocumentChunks(document.Id).Take(3))
                                {
                                    <article>
                                        <span>Chunk @chunk.ChunkNumber | Zeichen @chunk.StartCharacter-@chunk.EndCharacter</span>
                                        <p>@PreviewText(chunk.Text)</p>
                                    </article>
                                }
                            </details>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="workflow-panel span-2">
        <h2>Knowledge Review</h2>
        @if (_selectedProject?.KnowledgeItems.Count > 0)
        {
            <div class="knowledge-filters">
                <label>
                    Typ
                    <select @bind="_knowledgeTypeFilter">
                        <option value="">Alle Typen</option>
                        @foreach (var type in KnowledgeTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </label>
                <label>
                    Status
                    <select @bind="_knowledgeStatusFilter">
                        <option value="">Alle Status</option>
                        @foreach (var status in KnowledgeReviewStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </label>
                <span>@FilteredKnowledgeItems.Count() von @_selectedProject.KnowledgeItems.Count Elementen</span>
            </div>
            <div class="knowledge-table">
                @foreach (var item in FilteredKnowledgeItems)
                {
                    <div class="knowledge-row">
                        <div>
                            <strong>@item.Title</strong>
                            <span>@item.Type | @item.ReviewStatus</span>
                            <p>@item.Summary</p>
                            <div class="knowledge-origin">
                                <span>Quelle: @KnowledgeSourceDetail(item)</span>
                                <span>Provider: @KnowledgeProviderDetail(item)</span>
                                <span>Qualitaet: @item.ExtractionQuality</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.ReviewedBy) || !string.IsNullOrWhiteSpace(item.ReviewComment))
                            {
                                <div class="review-meta">
                                    <span>@ReviewItemDetail(item)</span>
                                    @if (!string.IsNullOrWhiteSpace(item.ReviewComment))
                                    {
                                        <p>@item.ReviewComment</p>
                                    }
                                </div>
                            }
                        </div>
                        <div class="button-row">
                            <button @onclick="() => SubmitReviewAsync(item.Id)" disabled="@(!Can(Permission.SubmitKnowledgeReview))">Review</button>
                            <button @onclick="() => ApproveAsync(item.Id)" disabled="@(!Can(Permission.ApproveKnowledge))">Freigeben</button>
                            <button @onclick="() => RejectAsync(item.Id)" disabled="@(!Can(Permission.RejectKnowledge))">Ablehnen</button>
                        </div>
                    </div>
                }
            </div>
            @if (!FilteredKnowledgeItems.Any())
            {
                <p class="muted">Keine Wissenselemente fuer diesen Filter.</p>
            }
        }
        else
        {
            <p class="muted">Noch keine Wissenselemente vorhanden.</p>
        }
        <div class="review-inputs">
            <label>
                Reviewer
                <input @bind="_reviewerName" />
            </label>
            <label>
                Qualitaet
                <select @bind="_reviewQualityStatus">
                    <option value="">Automatisch</option>
                    @foreach (var qualityStatus in RequestValidation.AllowedKnowledgeQualityStatuses)
                    {
                        <option value="@qualityStatus">@qualityStatus</option>
                    }
                </select>
            </label>
            <label>
                Kommentar
                <textarea @bind="_reviewComment"></textarea>
            </label>
        </div>
    </div>

    <div class="workflow-panel">
        <h2>Roadmap</h2>
        <div class="form-grid">
            <label>
                Zielrolle
                <input @bind="_roadmapRole" />
            </label>
            <label>
                Wochen
                <input type="number" min="1" max="8" @bind="_roadmapWeeks" />
            </label>
        </div>
        <button class="primary-action" @onclick="GenerateRoadmapAsync" disabled="@(_selectedProject is null || !Can(Permission.GenerateRoadmap))">Roadmap erzeugen</button>

        @if (_selectedProject?.Roadmaps.Count > 0)
        {
            <div class="compact-list roadmap-list">
                @foreach (var roadmap in _selectedProject.Roadmaps)
                {
                    <div>
                        <strong>@roadmap.TargetRole</strong>
                        <span>@roadmap.DurationInWeeks Wochen, @roadmap.Status</span>
                        <details class="roadmap-preview">
                            <summary>Roadmap anzeigen</summary>
                            @foreach (var week in roadmap.Weeks.OrderBy(week => week.WeekNumber))
                            {
                                <article>
                                    <header>
                                        <span>Woche @week.WeekNumber</span>
                                        <strong>@week.Theme</strong>
                                    </header>
                                    <div class="roadmap-week-grid">
                                        <section>
                                            <h3>Lernziele</h3>
                                            @RenderRoadmapItems(week.LearningGoals)
                                        </section>
                                        <section>
                                            <h3>Uebungen</h3>
                                            @RenderRoadmapItems(week.Exercises)
                                        </section>
                                        <section>
                                            <h3>Abschluss</h3>
                                            @RenderRoadmapItems(week.AcceptanceCriteria)
                                        </section>
                                        <section>
                                            <h3>Review-Hinweise</h3>
                                            @RenderRoadmapItems(week.ReviewNotes)
                                        </section>
                                    </div>
                                </article>
                            }
                        </details>
                    </div>
                }
            </div>
        }
    </div>

    <div class="workflow-panel">
        <h2>Export & Traceability</h2>
        <div class="button-row">
            <button @onclick="LoadTraceabilityAsync" disabled="@(_selectedProject is null || !Can(Permission.ViewTraceability))">Traceability laden</button>
            <button @onclick="ExportMarkdownAsync" disabled="@(_selectedProject is null || !Can(Permission.ExportProject))">Markdown Export</button>
            <button @onclick="LoadAuditAsync" disabled="@(_selectedProject is null || !Can(Permission.ViewTraceability))">Audit Log</button>
        </div>
        @if (_traceability is not null)
        {
            <p class="muted">@_traceability.Rows.Count Matrix-Zeilen generiert.</p>
            <div class="traceability-table" role="table" aria-label="Traceability Matrix">
                <div class="traceability-header" role="row">
                    <span role="columnheader">Quelle</span>
                    <span role="columnheader">Wissen</span>
                    <span role="columnheader">Herkunft</span>
                    <span role="columnheader">Review</span>
                    <span role="columnheader">Nutzung</span>
                </div>
                @foreach (var row in _traceability.Rows.OrderBy(row => row.DocumentName).ThenBy(row => row.KnowledgeTitle))
                {
                    <div class="traceability-row" role="row">
                        <div role="cell">
                            <strong>@row.DocumentName</strong>
                            <span>@row.DocumentStatus | @row.ChunkCount Chunks</span>
                        </div>
                        <div role="cell">
                            <strong>@(row.KnowledgeTitle ?? "Kein Wissenselement")</strong>
                            <span>@(row.KnowledgeType ?? "Nicht extrahiert")</span>
                        </div>
                        <div role="cell">
                            <strong>@TraceabilityExtractionDetail(row)</strong>
                            <span>@TraceabilityQualityDetail(row)</span>
                        </div>
                        <div role="cell">
                            <strong>@(row.KnowledgeReviewStatus ?? "-")</strong>
                            <span>@ReviewDetail(row)</span>
                        </div>
                        <div role="cell">
                            <strong>@row.RoadmapUsageCount Roadmap</strong>
                            <span>@(row.IncludedInExport ? "Exportiert" : "Nicht exportiert")</span>
                        </div>
                    </div>
                }
            </div>
        }
        @if (_auditEvents.Count > 0)
        {
            <div class="audit-filters">
                <label>
                    Aktion
                    <select @bind="_auditActionFilter">
                        <option value="">Alle Aktionen</option>
                        @foreach (var action in AuditActions)
                        {
                            <option value="@action">@action</option>
                        }
                    </select>
                </label>
                <label>
                    Zieltyp
                    <select @bind="_auditTargetTypeFilter">
                        <option value="">Alle Zieltypen</option>
                        @foreach (var targetType in AuditTargetTypes)
                        {
                            <option value="@targetType">@targetType</option>
                        }
                    </select>
                </label>
                <span>@FilteredAuditEvents.Count() von @_auditEvents.Count Events</span>
            </div>
            <div class="audit-table" role="table" aria-label="Audit Log">
                <div class="audit-header" role="row">
                    <span role="columnheader">Zeit</span>
                    <span role="columnheader">Aktion</span>
                    <span role="columnheader">Ziel</span>
                    <span role="columnheader">Zusammenfassung</span>
                </div>
                @foreach (var auditEvent in FilteredAuditEvents)
                {
                    <div class="audit-row" role="row">
                        <div role="cell">
                            <strong>@auditEvent.OccurredAt.LocalDateTime.ToString("g")</strong>
                            <span>@auditEvent.Actor</span>
                        </div>
                        <div role="cell">
                            <strong>@auditEvent.Action</strong>
                            <span>@auditEvent.Id</span>
                        </div>
                        <div role="cell">
                            <strong>@auditEvent.TargetType</strong>
                            <span>@(auditEvent.TargetId?.ToString() ?? "-")</span>
                        </div>
                        <div role="cell">
                            <strong>@auditEvent.Summary</strong>
                            <span>@(auditEvent.ProjectId?.ToString() ?? "Global")</span>
                        </div>
                    </div>
                }
            </div>
            @if (!FilteredAuditEvents.Any())
            {
                <p class="muted">Keine Audit-Events fuer diesen Filter.</p>
            }
        }
        @if (_export is not null)
        {
            <div class="export-summary">
                <div>
                    <span>Datei</span>
                    <strong>@_export.FileName</strong>
                </div>
                <div>
                    <span>Format</span>
                    <strong>@_export.ContentType</strong>
                </div>
                <div>
                    <span>Erzeugt</span>
                    <strong>@_export.GeneratedAt.LocalDateTime.ToString("g")</strong>
                </div>
                <div>
                    <span>Umfang</span>
                    <strong>@MarkdownLineCount(_export.Markdown) Zeilen | @FormatFileSize(_export.Markdown.Length)</strong>
                </div>
            </div>
            <div class="export-sections">
                @foreach (var section in ExportSections(_export.Markdown))
                {
                    <details>
                        <summary>@section.Title</summary>
                        <pre>@section.Preview</pre>
                    </details>
                }
            </div>
            <details class="export-full">
                <summary>Vollstaendiges Markdown anzeigen</summary>
                <textarea class="export-preview" readonly>@_export.Markdown</textarea>
            </details>
        }
    </div>

    <div class="workflow-panel span-2">
        <h2>Betrieb & Backups</h2>
        <div class="button-row">
            <button @onclick="LoadHealthAsync" disabled="@(!CanOperateBackups)">Status laden</button>
            <button @onclick="CreateBackupAsync" disabled="@(!CanOperateBackups)">Backup erstellen</button>
            <button @onclick="LoadBackupsAsync" disabled="@(!CanOperateBackups)">Backups laden</button>
            <button @onclick="PreviewBackupAsync" disabled="@(!CanPreviewBackup)">Backup pruefen</button>
            <button @onclick="RestoreBackupAsync" disabled="@(!CanRestoreBackup)">Backup wiederherstellen</button>
        </div>

        @if (_health is not null)
        {
            <div class="health-overview">
                <div>
                    <span>Service</span>
                    <strong>@_health.Service</strong>
                </div>
                <div>
                    <span>Status</span>
                    <strong class="@HealthStatusClass(_health.Status)">@_health.Status</strong>
                </div>
                <div>
                    <span>Zeitpunkt</span>
                    <strong>@_health.Timestamp.LocalDateTime.ToString("g")</strong>
                </div>
            </div>
            <div class="health-table" role="table" aria-label="Betriebsstatus">
                <div class="health-header" role="row">
                    <span role="columnheader">Komponente</span>
                    <span role="columnheader">Status</span>
                    <span role="columnheader">Details</span>
                    <span role="columnheader">Metadaten</span>
                </div>
                @foreach (var component in _health.Components.OrderBy(component => component.Name))
                {
                    <div class="health-row" role="row">
                        <div role="cell">
                            <strong>@component.Name</strong>
                        </div>
                        <div role="cell">
                            <strong class="@HealthStatusClass(component.Status)">@component.Status</strong>
                        </div>
                        <div role="cell">
                            <span>@component.Detail</span>
                        </div>
                        <div role="cell">
                            @foreach (var item in component.Metadata)
                            {
                                <span><strong>@item.Key</strong>: @MaskHealthValue(item.Key, item.Value)</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (_backups.Count > 0)
        {
            <label class="select-label">
                Backup
                <select @bind="_selectedBackupFileName">
                    @foreach (var backup in _backups)
                    {
                        <option value="@backup.FileName">@backup.FileName</option>
                    }
                </select>
            </label>
            @if (_backupPreview is not null)
            {
                <div class="backup-preview">
                    <div>
                        <span>Datei</span>
                        <strong>@_backupPreview.FileName</strong>
                    </div>
                    <div>
                        <span>Format</span>
                        <strong>@_backupPreview.Format</strong>
                    </div>
                    <div>
                        <span>Inhalt</span>
                        <strong>@_backupPreview.EntryCount Eintraege | @_backupPreview.UploadFileCount Uploads</strong>
                    </div>
                    <div>
                        <span>Groesse</span>
                        <strong>@FormatFileSize(_backupPreview.SizeInBytes)</strong>
                    </div>
                    @if (_backupPreview.Warnings.Count > 0)
                    {
                        <div class="span-2 backup-warning">
                            <span>Warnung</span>
                            <strong>@string.Join(" ", _backupPreview.Warnings)</strong>
                        </div>
                    }
                    <details class="span-2">
                        <summary>Backup-Eintraege anzeigen</summary>
                        <ul>
                            @foreach (var entry in _backupPreview.Entries)
                            {
                                <li>@entry</li>
                            }
                        </ul>
                    </details>
                    <p class="span-2 muted">Restore ist erst nach dieser Vorschau aktiv und ersetzt lokale Projekt-, Audit- und Upload-Daten aus dem Backup.</p>
                </div>
            }
            <div class="compact-list">
                @foreach (var backup in _backups.Take(5))
                {
                    <div>
                        <strong>@backup.FileName</strong>
                        <span>@backup.CreatedAt.LocalDateTime.ToString("g") | @FormatFileSize(backup.SizeInBytes)</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="muted">Noch keine lokalen Backups vorhanden.</p>
        }
    </div>
</section>

@code {
    private readonly CreateProjectRequestModel _newProject = new()
    {
        Name = "M3 Platform",
        Description = "Technical onboarding and knowledge transfer workspace.",
        Owner = "Engineering"
    };

    private IReadOnlyCollection<ProjectSummaryResponse> _projects = [];
    private ProjectDetailsResponse? _selectedProject;
    private Guid _selectedProjectId;
    private string _uploadSource = "Manual upload";
    private string _roadmapRole = "Support Engineer";
    private int _roadmapWeeks = 4;
    private string _knowledgeTypeFilter = string.Empty;
    private string _knowledgeStatusFilter = string.Empty;
    private string _auditActionFilter = string.Empty;
    private string _auditTargetTypeFilter = string.Empty;
    private string _reviewerName = "Senior Engineer";
    private string _reviewComment = "Reviewed from UI.";
    private string _reviewQualityStatus = string.Empty;
    private UserRole _currentRole = UserRole.Admin;
    private string StatusText { get; set; } = "Bereit";
    private string StatusDetail { get; set; } = "Lege ein Projekt an oder waehle ein bestehendes Projekt.";
    private bool HasError { get; set; }
    private TraceabilityMatrixResponse? _traceability;
    private ExportProjectMarkdownResponse? _export;
    private ExtractKnowledgeResponse? _lastExtraction;
    private HealthResponse? _health;
    private IReadOnlyCollection<AuditEventResponse> _auditEvents = [];
    private IReadOnlyCollection<BackupResponse> _backups = [];
    private BackupPreviewResponse? _backupPreview;
    private string? _selectedBackupFileName;

    private bool CanAnalyze => Can(Permission.AnalyzeDocument)
        && _selectedProject?.Documents.Any(document => document.Status == "Registered") == true;

    private bool CanExtract => Can(Permission.ExtractKnowledge)
        && _selectedProject?.Documents.Any(document => document.Status == "Analyzed") == true;

    private bool CanOperateBackups => _currentRole == UserRole.Admin;

    private bool CanRestoreBackup => CanOperateBackups
        && !string.IsNullOrWhiteSpace(_selectedBackupFileName)
        && _backupPreview?.FileName == _selectedBackupFileName;

    private bool CanPreviewBackup => CanOperateBackups
        && !string.IsNullOrWhiteSpace(_selectedBackupFileName);

    private IEnumerable<string> KnowledgeTypes => _selectedProject?.KnowledgeItems
        .Select(item => item.Type)
        .Distinct(StringComparer.Ordinal)
        .Order(StringComparer.Ordinal)
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> KnowledgeReviewStatuses => _selectedProject?.KnowledgeItems
        .Select(item => item.ReviewStatus)
        .Distinct(StringComparer.Ordinal)
        .Order(StringComparer.Ordinal)
        ?? Enumerable.Empty<string>();

    private IEnumerable<KnowledgeItemResponse> FilteredKnowledgeItems => _selectedProject?.KnowledgeItems
        .Where(item => string.IsNullOrWhiteSpace(_knowledgeTypeFilter) || item.Type == _knowledgeTypeFilter)
        .Where(item => string.IsNullOrWhiteSpace(_knowledgeStatusFilter) || item.ReviewStatus == _knowledgeStatusFilter)
        .OrderBy(item => item.ReviewStatus)
        .ThenBy(item => item.Type)
        .ThenBy(item => item.Title)
        ?? Enumerable.Empty<KnowledgeItemResponse>();

    private IEnumerable<string> AuditActions => _auditEvents
        .Select(auditEvent => auditEvent.Action)
        .Distinct(StringComparer.Ordinal)
        .Order(StringComparer.Ordinal);

    private IEnumerable<string> AuditTargetTypes => _auditEvents
        .Select(auditEvent => auditEvent.TargetType)
        .Distinct(StringComparer.Ordinal)
        .Order(StringComparer.Ordinal);

    private IEnumerable<AuditEventResponse> FilteredAuditEvents => _auditEvents
        .Where(auditEvent => string.IsNullOrWhiteSpace(_auditActionFilter) || auditEvent.Action == _auditActionFilter)
        .Where(auditEvent => string.IsNullOrWhiteSpace(_auditTargetTypeFilter) || auditEvent.TargetType == _auditTargetTypeFilter)
        .OrderByDescending(auditEvent => auditEvent.OccurredAt);

    private bool Can(Permission permission)
    {
        return Permissions.HasPermission(_currentRole, permission);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadProjectsAsync();
        await LoadBackupsAsync();
        await LoadHealthAsync();
    }

    private async Task CreateProjectAsync()
    {
        if (!Can(Permission.CreateProject))
        {
            SetStatus("Keine Berechtigung", "Diese Rolle darf keine Projekte anlegen.", isError: true);
            return;
        }

        await RunSafelyAsync("Projekt anlegen", async () =>
        {
            var created = await Projects.CreateAsync(
                new CreateProjectRequest(_newProject.Name, _newProject.Description, _newProject.Owner),
                CancellationToken.None);

            _selectedProjectId = created.Id;
            await LoadProjectsAsync();
            await LoadSelectedProjectAsync();
            SetStatus("Projekt angelegt", created.Name);
        });
    }

    private async Task SelectProjectAsync(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var projectId))
        {
            _selectedProjectId = projectId;
            await LoadSelectedProjectAsync();
        }
    }

    private async Task UploadDocumentAsync(InputFileChangeEventArgs args)
    {
        if (_selectedProject is null || !Can(Permission.UploadDocument))
        {
            return;
        }

        await RunSafelyAsync("Dokument hochladen", async () =>
        {
            var file = args.File;
            var errors = DocumentFileValidation.Validate(file.Name, file.ContentType, file.Size);
            if (errors.Count > 0)
            {
                SetStatus("Dokument hochladen fehlgeschlagen", ToValidationMessage(errors), isError: true);
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: DocumentFileValidation.MaxUploadSizeInBytes);
            var upload = await Projects.UploadDocumentAsync(
                _selectedProject.Id,
                new UploadDocumentCommand(file.Name, file.ContentType, _uploadSource, stream),
                CancellationToken.None);

            await LoadSelectedProjectAsync();
            SetStatus("Dokument hochgeladen", upload?.Document.FileName ?? file.Name);
        });
    }

    private async Task AnalyzeLatestDocumentAsync()
    {
        var document = _selectedProject?.Documents.LastOrDefault(candidate => candidate.Status == "Registered");
        if (_selectedProject is null || document is null)
        {
            return;
        }

        await RunSafelyAsync("Dokument analysieren", async () =>
        {
            await Analysis.AnalyzeAsync(_selectedProject.Id, document.Id, CancellationToken.None);
            await LoadSelectedProjectAsync();
            SetStatus("Analyse abgeschlossen", document.FileName);
        });
    }

    private async Task ExtractKnowledgeAsync()
    {
        var document = _selectedProject?.Documents.LastOrDefault(candidate => candidate.Status == "Analyzed");
        if (_selectedProject is null || document is null)
        {
            return;
        }

        await RunSafelyAsync("Wissen extrahieren", async () =>
        {
            var extraction = await Extraction.ExtractAsync(_selectedProject.Id, document.Id, CancellationToken.None);
            await LoadSelectedProjectAsync();
            _lastExtraction = extraction;
            SetStatus("Wissen extrahiert", ExtractionStatusDetail(extraction));
        });
    }

