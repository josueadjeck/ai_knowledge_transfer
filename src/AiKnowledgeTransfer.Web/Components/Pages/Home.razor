    {
        if (string.IsNullOrWhiteSpace(item.ReviewedBy))
        {
            return "Noch kein Reviewer gespeichert.";
        }

        return item.ReviewedAt is null
            ? item.ReviewedBy
            : $"{item.ReviewedBy} | {item.ReviewedAt.Value.LocalDateTime:g}";
